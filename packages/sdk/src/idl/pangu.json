    {
      "name": "PriceBand",
      "docs": [
        "The price band settings, passed to `create_sale` as one value.",
        "",
        "They travel together because they are only meaningful together: the quote",
        "account's address is derived from the queue and both feed ids, so changing any",
        "one of them changes which account the hook must read."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "band_bps",
            "docs": [
              "How far above the live stock price a buy may leave the curve price, in",
              "basis points. Zero switches the whole band off."
            ],
            "type": "u16"
          },
          {
            "name": "price_account",
            "docs": [
              "The Switchboard quote account. Must be the canonical address for the queue",
              "and the two feed ids below."
            ],
            "type": "pubkey"
          },
          {
            "name": "price_queue",
            "docs": [
              "The Switchboard queue whose oracles sign the quote."
            ],
            "type": "pubkey"
          },
          {
            "name": "price_feed_id",
            "docs": [
              "The feed carrying the stock price in dollars."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "clock_feed_id",
            "docs": [
              "The feed carrying the time of the last real market trade, in Unix seconds."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "max_price_age_slots",
