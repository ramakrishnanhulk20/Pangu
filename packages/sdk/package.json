{
  "name": "pangu-sdk",
  "version": "0.1.0",
  "description": "Find a Pangu sale's accounts, read the sale and its buyers, and build Pangu's instructions.",
  "license": "MIT",
  "keywords": [
    "solana",
    "meteora",
    "dynamic-bonding-curve",
    "token-2022",
    "transfer-hook",
    "stock-tokens",
    "pyth",
    "fair-launch"
  ],
  "homepage": "https://github.com/ramakrishnanhulk20/Pangu/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/ramakrishnanhulk20/Pangu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramakrishnanhulk20/Pangu.git",
    "directory": "packages/sdk"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dbc": {
      "import": {
        "types": "./dist/dbc.d.mts",
        "default": "./dist/dbc.mjs"
      },
      "require": {
        "types": "./dist/dbc.d.ts",
        "default": "./dist/dbc.js"
      }
    },
    "./price": {
      "import": {
        "types": "./dist/price.d.mts",
        "default": "./dist/price.mjs"
      },
      "require": {
        "types": "./dist/price.d.ts",
        "default": "./dist/price.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "sync-idl": "node scripts/idl.mjs sync",
    "build": "node scripts/idl.mjs check && tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.12",
    "@pythnetwork/pyth-solana-receiver": "0.16.0",
    "@solana/spl-token": "0.4.15",
    "buffer": "6.0.3"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98"
  },
  "devDependencies": {
    "@solana/web3.js": "1.98.4",
    "@types/node": "26.6.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "jito-ts": {
      "@solana/web3.js": "1.98.4"
    }
  }
}
