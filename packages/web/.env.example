# Copy to .env.local. Every name starting with NEXT_PUBLIC_ is compiled into the
# browser bundle and is readable by anyone. The Pyth key, the demo dollar key and
# the price refresh key stay server side only, in the repository root .env on a
# developer machine.

# Which network this build is for: devnet (the default when empty) or mainnet.
# One setting and a rebuild switch the whole app: its endpoint, paying tokens,
# explorer links, words, and whether demo dollars and the faucet exist. Any other
# value stops the build.
NEXT_PUBLIC_PANGU_NETWORK=

# Devnet RPC the server reads sales through: the hero, the readout and the price
# route. Server only, never sent to a browser, so this one may carry a full API
# key. On a developer machine it can live in the repository root .env instead,
# which the app loads when this is unset. Empty falls back to the browser's
# endpoint below, then to the public devnet endpoint.
DEVNET_RPC_URL=

# Devnet RPC the browser uses: the wallet connection. Compiled into the bundle,
# so leave it empty for the public devnet endpoint, or use a key the provider
# restricts to this site's origin in its own dashboard. Never an unrestricted key.
NEXT_PUBLIC_DEVNET_RPC_URL=

# Mainnet only, read when NEXT_PUBLIC_PANGU_NETWORK=mainnet. The same two roles
# as the devnet pair above: the server's keyed endpoint, and the browser's
# public or origin-restricted one. Empty falls back to the public mainnet
# endpoint, which rate limits hard. Pointing both at http://localhost:8899 runs
# the mainnet app against the forked-mainnet rehearsal validator, and every page
# then says "rehearsal".
MAINNET_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=

# Mainnet only: the key that pays for Pyth price posts, as the JSON array a
# Solana key file holds, on one line. Server only. A key made for this job and
# nothing else, never the demo dollar key. Each post costs about 0.000035 SOL and
# the app sends at most one a minute, so the worst case is about 0.05 SOL a day.
# Fund it with 0.5 SOL. Under 0.05 SOL it stops posting, buys on a banded sale
# wait for a fresh price, and the server log names the key's address to top up.
PRICE_REFRESH_KEY=

# Optional, for local checks only. NEXT_DIST_DIR sends a verification build to
# another folder so it never disturbs the .next the dev server holds open. The
# other two steer the evidence scripts under lab-evidence: the app they post to,
# and a wallet whose ledger run they replay. Empty means their defaults.
NEXT_DIST_DIR=
DOLLARS_BASE_URL=
PANGU_LEDGER_WALLET=
