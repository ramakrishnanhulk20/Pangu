# Copy to .env.local. Nothing secret belongs in this file: every name starting
# with NEXT_PUBLIC_ is compiled into the browser bundle and is readable by
# anyone. The Pyth key stays in the repository root .env, server side only.

# Devnet RPC the app reads sales through. Empty means the public endpoint,
# https://api.devnet.solana.com
NEXT_PUBLIC_DEVNET_RPC_URL=

# Optional, for local checks only. NEXT_DIST_DIR sends a verification build to
# another folder so it never disturbs the .next the dev server holds open. The
# other two steer the evidence scripts under lab-evidence: the app they post to,
# and a wallet whose ledger run they replay. Empty means their defaults.
NEXT_DIST_DIR=
DOLLARS_BASE_URL=
PANGU_LEDGER_WALLET=
