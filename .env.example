# Copy this file to .env and fill in the values. .env is never committed. The
# scripts take a path to a key file rather than a key; the one place a key's own
# bytes are named is DEMO_DOLLAR_MINT_AUTHORITY at the foot of this file, which a
# hosted deploy has no key file for. The other secret is the Pyth API key. Both
# are read server side and neither is ever printed.

# Path to the Solana keypair file the Windows devnet scripts pay with. Make one
# with: solana-keygen new --outfile C:\Users\you\.config\solana\pangu-demo-devnet.json
DEVNET_PAYER_KEYPAIR=

# Pyth's Hermes API key, needed for every price read since 26 Aug 2026. Read from
# the environment by the refresh, server side only, and never sent to a browser.
PYTH_API_KEY=

# Devnet RPC. Empty means the public endpoint, https://api.devnet.solana.com
DEVNET_RPC_URL=

# Mainnet RPC, read only by the feed scripts that print mainnet feed ids. Empty
# means the public endpoint. Nothing in this repository sends a mainnet transaction.
MAINNET_RPC_URL=

# How many random operations, and which seeds, the program's random sequence
# test runs. Empty means its own defaults: 600 operations and five seeds. The
# test prints both back when it finds a failure, so a run can be replayed.
PANGU_RANDOM_OPS=
PANGU_RANDOM_SEEDS=

# Optional: the deployed site. When set, the status command checks it answers and says Pangu.
APP_URL=

# The devnet demo key as the JSON array its key file holds, on one line: the
# site's demo dollar button mints with it, paying about 0.002 SOL of rent and a
# fee per grant. Server side only, never NEXT_PUBLIC_, and .env is not committed.
DEMO_DOLLAR_MINT_AUTHORITY=
