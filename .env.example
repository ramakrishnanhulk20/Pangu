# Copy this file to .env and fill in the values. .env is never committed, and no
# value here is ever a key: the wallet variable holds a path to a key file.

# Path to the Solana keypair file the Windows devnet scripts pay with. Make one
# with: solana-keygen new --outfile C:\Users\you\.config\solana\pangu-demo-devnet.json
DEVNET_PAYER_KEYPAIR=

# Devnet RPC. Empty means the public endpoint, https://api.devnet.solana.com
DEVNET_RPC_URL=

# Mainnet RPC, read only by the feed scripts that print mainnet feed ids. Empty
# means the public endpoint. Nothing in this repository sends a mainnet transaction.
MAINNET_RPC_URL=

# How many random operations, and which seeds, the program's random sequence
# test runs. Empty means its own defaults: 600 operations and five seeds. The
# test prints both back when it finds a failure, so a run can be replayed.
PANGU_RANDOM_OPS=
PANGU_RANDOM_SEEDS=
